### [변수 설정]
@host = http://localhost:8080
@userId = 1
@today = 2026-01-20
@mood = HAPPY

# ------------------------------------------------------------
# 1. 일기 작성 (POST)
# ------------------------------------------------------------
POST {{host}}/api/diaries
Content-Type: application/json

{
  "userId": {{userId}},
  "writtenDate": "{{today}}",
  "content": "오늘은 API 컨트롤러 테스트를 하는 날이다. 생각보다 재미있다.",
  "moodCode": "{{mood}}"
}

###

# ------------------------------------------------------------
# 2. 특정 날짜 일기 조회 (GET)
# 설명: 방금 쓴 일기가 잘 나오는지 확인
# ------------------------------------------------------------
GET {{host}}/api/diaries?userId={{userId}}&date={{today}}
Accept: application/json

###

# ------------------------------------------------------------
# 3. 일기 수정 (PUT)
# 주의: URL의 '1'은 수정할 일기의 diaryId입니다. (DB 확인 후 변경 필요할 수 있음)
# 설명: 내용은 바꾸고, 작성자 ID는 검증용으로 꼭 같이 보내야 합니다.
# ------------------------------------------------------------
PUT {{host}}/api/diaries/1
Content-Type: application/json

{
  "userId": {{userId}},
  "writtenDate": "{{today}}",
  "content": "일기 내용을 수정했다! 코딩은 역시 수정하는 맛이지.",
  "moodCode": "SAD"
}

###

# ------------------------------------------------------------
# 4. 월별 일기 목록 조회 (GET)
# 설명: year와 month를 숫자로 보냅니다.
# ------------------------------------------------------------
GET {{host}}/api/diaries/monthly?userId={{userId}}&year=2026&month=1
Accept: application/json

###

# ------------------------------------------------------------
# 5. 일기 삭제 (DELETE)
# 주의: URL의 '1'은 삭제할 diaryId입니다.
# 설명: 쿼리 파라미터(?userId=1)로 본인 확인용 ID를 같이 보냅니다.
# ------------------------------------------------------------
DELETE {{host}}/api/diaries/2?userId={{userId}}